{
    "name": "blyattebayo/polymorph-sdk",
    "description": "Polymorph Extension SDK (V2): the only allowed surface between extensions and the core platform.",
    "type": "library",
    "license": "MIT",
    "version": "2.1.0",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Polymorph\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polymorph\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
